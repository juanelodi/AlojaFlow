includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - config
        - database
        - routes
    tmpDir: storage/framework/cache/phpstan
    ignoreErrors:
        # sabre/vobject no declara tipos genéricos en sus iteradores.
        - identifier: missingType.iterableValue
          path: app/Ical/*
