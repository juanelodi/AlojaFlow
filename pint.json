{
    "preset": "psr12",
    "exclude": [
        "bootstrap/cache",
        "instalador",
        "storage",
        "vendor"
    ],
    "rules": {
        "declare_strict_types": true,
        "header_comment": {
            "header": "AlojaFlow — sistema de gestión de alojamientos\nCopyright (C) 2026 juanelodi y colaboradores de AlojaFlow\nSPDX-License-Identifier: AGPL-3.0-or-later",
            "comment_type": "comment",
            "location": "after_open",
            "separate": "both"
        },
        "array_syntax": {
            "syntax": "short"
        },
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "single_quote": true,
        "trailing_comma_in_multiline": {
            "elements": ["arrays"]
        }
    }
}
